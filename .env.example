# Single .env at repo root, consumed by docker-compose and by the web app
# (see apps/web/vite.config.ts's sveltekit env.dir, which points here) —
# see contracts §1. Copy this to .env and fill in real values; .env itself
# is gitignored and must never be committed.
#
# docker compose --env-file .env -f infra/docker/compose.yml up -d

# --- Postgres ---
POSTGRES_DB=thalassa
POSTGRES_USER=thalassa
POSTGRES_PASSWORD=admin@123
POSTGRES_HOST=localhost          # "postgres" inside the compose network
POSTGRES_PORT=5432
# The password's @ must be percent-encoded (%40) here — an unescaped @ in a
# URL's userinfo is ambiguous with the host delimiter and breaks parsing
# (confirmed: psycopg reads "123" as the hostname without this).
DATABASE_URL=postgresql+asyncpg://thalassa:admin%40123@localhost:5432/thalassa

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=thalassa
MINIO_ROOT_PASSWORD=admin@123
MINIO_BUCKET=tiles

# --- Web (must be PUBLIC_ prefixed to reach client code) ---
# Must stay PUBLIC_-prefixed so SvelteKit exposes it to client code. Public
# base URL the browser uses to fetch PMTiles vector tiles directly from
# MinIO (public-read bucket + CORS — see infra/docker/compose.yml).
PUBLIC_TILES_BASE_URL=http://localhost:9000/tiles
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Browser origin minio-init allows via server-wide CORS (apps/web dev server).
WEB_ORIGIN=http://localhost:5173

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
SESSION_SECRET=dev-only-change-me
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
