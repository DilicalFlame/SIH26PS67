{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "build/**",
                ".svelte-kit/**",
                "dist/**"
            ]
        },
        "test": {
            "outputs": []
        },
        "lint": {
            "outputs": []
        },
        "check": {
            "outputs": []
        }
    }
}
