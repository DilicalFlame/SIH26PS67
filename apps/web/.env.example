# Public base URL the browser uses to fetch PMTiles vector tiles directly
# from MinIO (public-read bucket + CORS — see infra/docker/compose.yml).
# Must stay PUBLIC_-prefixed so SvelteKit exposes it to client code.
PUBLIC_TILES_BASE_URL=http://localhost:9000/tiles
# Optional bounds-query endpoint returning an array of { lon, lat } objects.
PUBLIC_FLOATS_URL=/api/floats
