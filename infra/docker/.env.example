# MinIO root credentials (S3 access key / secret key).
MINIO_ROOT_USER=thalassa
MINIO_ROOT_PASSWORD=admin@123

# Bucket that PMTiles/asset objects live in, and the browser origin the
# minio-init service allows via server-wide CORS (apps/web dev server).
MINIO_BUCKET=tiles
WEB_ORIGIN=http://localhost:5173
